{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "create-admin": "ts-node src/scripts/createAdmins.ts",
    "seed:rooms": "ts-node src/scripts/seedRooms.ts",
    "db:init": "ts-node src/scripts/initDb.ts",
    "db:setup": "npm run db:init && npm run create-admin && npm run seed:rooms",
    "db:deploy": "node dist/scripts/initDb.js && node dist/scripts/createAdmins.js && node dist/scripts/seedRooms.js",
    "load:setup": "ts-node load-tests/setup-load-test.ts",
    "load:test": "artillery run load-tests/artillery.yml",
    "load:report": "artillery run --output load-tests/report.json load-tests/artillery.yml && artillery report load-tests/report.json",
    "load:quick": "artillery quick --count 100 --num 10 http://localhost:5000/health"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
